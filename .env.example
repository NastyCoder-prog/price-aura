# ---------------------------------------------------------------------------
# PriceAura environment variables
# Copy to `.env.local` for local development; set the same names in
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ----------------------------------------------------
# Use the POOLED connection string (port 6543 on Supabase, the "pooled" URL
# on Neon/Vercel Postgres). See DEPLOY.md.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# --- Cron (REQUIRED in production) ------------------------------------------
# Long random string; Vercel Cron sends it as `Authorization: Bearer …`.
# The cron endpoint FAILS CLOSED if this is unset in production.
CRON_SECRET=generate-a-long-random-string

# --- Email alerts (optional but recommended) --------------------------------
# Resend API key. Without it, price-drop emails are logged instead of sent.
RESEND_API_KEY=
# Verified sender, e.g. "PriceAura <alerts@yourdomain.com>".
EMAIL_FROM=
# Secret used to sign one-click unsubscribe links in emails.
# Falls back to CRON_SECRET if unset.
EMAIL_SIGNING_SECRET=

# --- Scraping (everything works WITHOUT any of these) -----------------------
# The default pipeline is free + unlimited: Bing Shopping aggregates live
# listings from many stores in one request. The keys below are optional
# enhancers that add Google Shopping coverage (incl. Amazon/Flipkart).
#
# SerpAPI — free tier ~100 google_shopping searches/month.
SERPAPI_API_KEY=
# Paid anti-bot render APIs (used last, for Google pages that need JS).
SCRAPERAPI_API_KEY=
SCRAPINGBEE_API_KEY=

# --- Abuse protection (optional) --------------------------------------------
# Upstash Redis REST credentials enable real distributed rate limiting on
# Vercel. Without them a best-effort in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Frontend ---------------------------------------------------------------
# Only needed if the API is hosted on a different origin than the frontend.
NEXT_PUBLIC_API_URL=
